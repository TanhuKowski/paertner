PAYLOAD_SECRET=replace-with-at-least-32-random-characters
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# PostgreSQL is recommended for production. Otherwise a local SQLite database is used.
# DATABASE_URI=postgresql://...
# INITIAL_ADMIN_EMAIL=you@example.com
# INITIAL_ADMIN_PASSWORD=use-a-long-unique-password
# Optional persistent object storage for media
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=
# paertner Dashboard (app.paertner.com) manages this website through the REST API.
# DASHBOARD_API_KEY: the API key of the service account app@paertner.com, created or updated on start.
# DASHBOARD_URL: where /admin redirects and where new inquiries are announced.
# DASHBOARD_WEBHOOK_SECRET: shared secret for the inquiry webhook (WEBSITE_WEBHOOK_SECRET in the dashboard).
# DASHBOARD_API_KEY=
# DASHBOARD_URL=https://app.paertner.com
# DASHBOARD_WEBHOOK_SECRET=
